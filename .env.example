# Flask / app
FLASK_ENV=production
SECRET_KEY=your_long_random_secret_here
APP_PORT=5000
DEV_BIND_PORT=5000
MAX_CONTENT_LENGTH_MB=64

# Traefik routing
TRAEFIK_DEV_HOST=dev.example.com
TRAEFIK_PROD_HOST=app.example.com
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=your_certresolver
TRAEFIK_DEV_MIDDLEWARES=your_middleware@file

# WorldTides API (optional but required for GPX -> XYZ tide correction)
# Get your API key at: https://www.worldtides.info/
WORLDTIDES_API_KEY=